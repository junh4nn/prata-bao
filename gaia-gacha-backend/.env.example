# Copy to .env for local dev. In production, these are set via `fly secrets set`,
# never as a deployed .env file.

SUPABASE_URL=
# Bypasses Row Level Security entirely — keep backend-only, never expose to any client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
PORT=3000
# The frontend origin allowed to call this API (e.g. the itch.io game page URL). Falls
# back to localhost if unset, so local dev works without configuring this.
ALLOWED_ORIGIN=
